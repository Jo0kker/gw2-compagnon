<Window x:Class="Companion.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Companion.Desktop"
 Title="{local:Tr AppTitle}" Width="1280" Height="850" MinWidth="840" MinHeight="580" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="24,12,24,16">
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
  <TabControl Background="Transparent" BorderThickness="0" Foreground="#EAF0F6">
   <TabItem Header="{local:Tr Dashboard}">
    <DockPanel Margin="0,20,0,0">
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="{Binding EditLabel}" Click="ToggleEdit" Background="#0C8390"/>
      <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" AutomationProperties.Name="{local:Tr ActiveProfile}"/>
      <ComboBox Width="180" HorizontalAlignment="Left" ItemsSource="{Binding Pages}" SelectedItem="{Binding Page}" DisplayMemberPath="Name" AutomationProperties.Name="{local:Tr ActivePage}"/>
     </DockPanel>
     <Border DockPanel.Dock="Top" Background="#1A3043" Padding="14,10" CornerRadius="4" Margin="0,0,0,16">
      <TextBlock Text="{Binding ConnectionLabel}" Foreground="#AEDCE7"/>
     </Border>
     <StackPanel DockPanel.Dock="Top" Visibility="{Binding Editing, Converter={StaticResource Visible}}" Margin="0,0,0,14">
      <WrapPanel Margin="0,0,0,10">
       <TextBox x:Name="ProfileNameInput" Text="{Binding ProfileName, Mode=OneWay}" Width="190" MaxLength="80" AutomationProperties.Name="{local:Tr ProfileName}"/>
       <Button Content="{local:Tr Rename}" Click="RenameProfile"/><Button Content="{local:Tr NewProfile}" Click="NewProfile"/>
       <Button Content="{local:Tr DuplicateProfile}" Click="DuplicateProfile"/><Button Content="{local:Tr DeleteProfile}" Click="DeleteProfile"/>
       <Button Content="{local:Tr Import}" Click="ImportProfile"/><Button Content="{local:Tr Export}" Click="ExportProfile"/>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,10">
       <TextBox x:Name="PageNameInput" Text="{Binding PageName, Mode=OneWay}" Width="190" MaxLength="80" AutomationProperties.Name="{local:Tr PageName}"/>
       <Button Content="{local:Tr RenamePage}" Click="RenamePage"/><Button Content="{local:Tr DuplicatePage}" Click="DuplicatePage"/>
       <Button Content="{local:Tr DeletePage}" Click="DeletePage"/>
       <Button Content="{local:Tr AddPage}" Click="AddPage"/>
      </WrapPanel>
      <WrapPanel>
       <Button Content="{local:Tr AddPlayers}" Tag="damage-players" Click="AddWidget"/>
       <Button Content="{local:Tr AddGroups}" Tag="damage-groups" Click="AddWidget"/>
       <TextBlock Text="{local:Tr MoveHint}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </WrapPanel>
     </StackPanel>
     <Grid>
      <TextBlock Text="{local:Tr NoWidgets}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="16" Visibility="{Binding NoWidgets, Converter={StaticResource Visible}}"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
       <ItemsControl ItemsSource="{Binding Widgets}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/><Setter Property="Visibility" Value="{Binding Display, Converter={StaticResource Visible}}"/></Style></ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:WidgetViewModel}">
         <Border Width="{Binding Width}" Height="{Binding Height}" Background="{StaticResource Surface}" BorderBrush="#2A3B4B" BorderThickness="1" CornerRadius="5">
          <Grid Margin="16">
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <DockPanel Margin="0,0,0,12">
            <Thumb DockPanel.Dock="Left" Width="26" Height="28" Margin="0,0,8,0" Cursor="SizeAll" Focusable="True" Background="#3BCBD0" DragDelta="MoveWidget" DragCompleted="FinishDrag" KeyDown="MoveWithKeyboard" ToolTip="{local:Tr MoveWidget}" AutomationProperties.Name="{local:Tr MoveWidget}" Visibility="{Binding Editing, Converter={StaticResource Visible}}"/>
            <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
           </DockPanel>
           <StackPanel Grid.Row="1" Visibility="{Binding Editing, Converter={StaticResource Visible}}" Margin="0,0,0,12">
            <WrapPanel Margin="0,0,0,8"><Button Content="{local:Tr Duplicate}" Click="DuplicateWidget"/><Button Content="{Binding HideLabel}" Click="HideWidget"/><Button Content="{local:Tr Remove}" Click="RemoveWidget"/></WrapPanel>
            <WrapPanel>
             <TextBlock Text="{local:Tr GroupFilter}" VerticalAlignment="Center" Margin="0,0,8,0"/>
             <ComboBox Width="65" ItemsSource="{x:Static local:WidgetViewModel.Groups}" SelectedItem="{Binding Group}" AutomationProperties.Name="{local:Tr SubgroupFilter}"/>
             <TextBlock Text="{local:Tr Rows}" VerticalAlignment="Center" Margin="0,0,8,0"/>
             <ComboBox Width="65" ItemsSource="{x:Static local:WidgetViewModel.RowOptions}" SelectedItem="{Binding Rows}" AutomationProperties.Name="{local:Tr RowCount}"/>
            </WrapPanel>
           </StackPanel>
           <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Data}" FontSize="16" SelectionMode="Single" AutomationProperties.Name="{local:Tr DemoDamage}">
             <DataGrid.Columns>
              <DataGridTextColumn Header="{local:Tr PlayerGroup}" Binding="{Binding Player}" Width="*" MinWidth="130"/>
              <DataGridTextColumn Header="{local:Tr GroupShort}" Binding="{Binding Subgroup}" Width="50"/>
              <DataGridTextColumn Header="{local:Tr Damage}" Binding="{Binding Damage, StringFormat=N0}" Width="110"/>
              <DataGridTextColumn Header="{local:Tr Dps}" Binding="{Binding Dps, StringFormat=N0, TargetNullValue=—}" Width="85"/>
             </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding EmptyMessage}" Visibility="{Binding Empty, Converter={StaticResource Visible}}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="12,56,12,0" IsHitTestVisible="False"/>
           </Grid>
           <TextBlock Grid.Row="3" Text="{Binding Source}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,14,20,0" FontSize="12"/>
           <Thumb Grid.RowSpan="4" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="#3BCBD0" DragDelta="ResizeWidget" DragCompleted="FinishDrag" Focusable="True" KeyDown="ResizeWithKeyboard" AutomationProperties.Name="{local:Tr ResizeWidget}" Visibility="{Binding Editing, Converter={StaticResource Visible}}"/>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
     </Grid>
    </DockPanel>
   </TabItem>
   <TabItem Header="{local:Tr Encounters}">
    <StackPanel Margin="16,32" MaxWidth="720" HorizontalAlignment="Left">
     <TextBlock Text="{local:Tr EncountersReports}" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="{local:Tr NoEncounters}" Margin="0,24,0,8" FontSize="18"/>
     <TextBlock Text="{local:Tr EncountersPlanned}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="{local:Tr Integrations}">
    <StackPanel Margin="16,32" MaxWidth="720" HorizontalAlignment="Left">
     <TextBlock Text="{local:Tr DataSources}" FontSize="28" FontWeight="SemiBold"/>
     <CheckBox Content="{local:Tr EnableReplay}" IsChecked="{Binding ReplayEnabled}" Foreground="#EAF0F6" Margin="0,24,0,12" FontSize="18"/>
     <TextBlock Text="{local:Tr ReplayHelp}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
     <CheckBox Content="{local:Tr EnableSimulator}" IsChecked="{Binding UseLocalBridge}" Foreground="#EAF0F6" Margin="0,24,0,12" FontSize="18"/>
     <TextBlock Text="{Binding BridgeSummary}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="{local:Tr SimulatorHelp}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
     <TextBlock Text="{local:Tr ArcPlanned}" FontSize="20" Margin="0,32,0,10"/>
     <TextBlock Text="{local:Tr ArcHelp}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="{local:Tr Settings}">
    <StackPanel Margin="16,32" MaxWidth="800" HorizontalAlignment="Left">
     <TextBlock Text="{local:Tr Language}" FontSize="20" Margin="0,0,0,10"/>
     <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{x:Static local:DashboardViewModel.Languages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage}" AutomationProperties.Name="{local:Tr Language}"/>
     <TextBlock Text="{local:Tr LanguageHelp}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,24"/>
     <TextBlock Text="{local:Tr StorageDiagnostics}" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="{local:Tr LocalProfiles}" Margin="0,24,0,10" FontSize="18"/>
     <TextBox Text="{Binding StoragePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="{local:Tr ProfilePath}"/>
     <TextBlock Text="{local:Tr BackupHelp}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
     <TextBlock Text="{local:Tr PreviewStatus}" Margin="0,24,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
