<Application x:Class="Companion.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <SolidColorBrush x:Key="Surface" Color="#182330"/>
  <SolidColorBrush x:Key="Muted" Color="#AABCCE"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#101A26"/><Setter Property="Foreground" Value="#EAF0F6"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#25384A"/><Setter Property="Foreground" Value="#EAF0F6"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#36536B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#41CCD1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="#101A26"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#25384A"/><Setter Property="Foreground" Value="#EAF0F6"/><Setter Property="BorderBrush" Value="#496078"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#EAF0F6"/><Setter Property="Padding" Value="20,12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,3"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#3BCBD0"/><Setter Property="Foreground" Value="#3BCBD0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#182330"/><Setter Property="Foreground" Value="#EAF0F6"/><Setter Property="RowBackground" Value="#182330"/><Setter Property="AlternatingRowBackground" Value="#1C2937"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#293848"/>
   <Setter Property="RowHeight" Value="40"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#182330"/><Setter Property="Foreground" Value="#AABCCE"/><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Application.Resources>
</Application>
